# Optional settings for the MCP quadlet (deploy/quadlet/branchwarden-mcp.container).
# Copy to ~/.config/branchwarden/branchwarden-mcp.env and edit as needed.
# Only the MCP service reads this file: no database password or app secret key belongs here.

# Keep these two in step with branchwarden.env, which the dashboard uses.
# Behind a reverse proxy doing HTTPS, the dashboard listens on plain HTTP on
# 8080 inside its container; set DASHBOARD_PORT=8443 there and here to keep the
# published port. BRANCHWARDEN_TLS=off makes the MCP service listen on plain
# HTTP too, for the proxy to front.
# BRANCHWARDEN_TLS=on
# DASHBOARD_PORT=8443

# The names the MCP service answers to (comma-separated name:port; empty answers any).
# MCP_ALLOWED_HOSTS=

# The port it listens on inside the container. Change PublishPort in the
# .container file as well if you change this.
# MCP_PORT=8765
