# Branchwarden: environment configuration
# ---------------------------------------
# Copy this file to .env and fill in what's marked required.
#
# Only the database, the dashboard's address, TLS and the secret key are read
# from here every time. The GitHub settings below are imported on the first
# start only; from then on they're changed in the dashboard under Settings.

# ── Database (always .env) ───────────────────────────────
# Required. compose refuses to start without it. Make one with: openssl rand -hex 24
POSTGRES_PASSWORD=
# POSTGRES_USER=branchwarden
# POSTGRES_DB=branchwarden
# Postgres isn't published outside the compose network. If you point Branchwarden
# at a database on another host instead (DATABASE_URL), turn on TLS with
# certificate checks: PGSSLMODE=verify-full and PGSSLROOTCERT=/path/to/ca.pem.
# DATABASE_URL=

# ── Secret key (always .env, or its own volume) ──────────
# Encrypts the GitHub token, the App's private key, the webhook secret and the
# channels' webhook URLs (AES-256-GCM), and signs sessions. Leave it blank and
# one is generated on the first start into the "keys" volume, apart from the
# database: back that volume up. To set your own: openssl rand -hex 32
BRANCHWARDEN_SECRET_KEY=
# Rotating: move the old value here, set a new one above, restart. Secrets are
# sealed again with the new key on start; then remove this line.
# BRANCHWARDEN_SECRET_KEY_PREVIOUS=

# ── Dashboard address and TLS (always .env) ──────────────
# Where the HTTPS port is published. Use 127.0.0.1:8443 to keep it to this host.
DASHBOARD_EXPOSE=8443
# Extra names and IP addresses for the self-signed certificate made on the first
# start, comma-separated. Upload a proper certificate later under Settings › TLS.
TLS_HOSTNAMES=
# Only behind a reverse proxy that does HTTPS itself:
# BRANCHWARDEN_TLS=off
# BRANCHWARDEN_BEHIND_PROXY=true
# For a local test over plain HTTP only (cookies stop being marked Secure):
# BRANCHWARDEN_INSECURE_HTTP=true

# ── GitHub (imported once, then edited in the dashboard) ─
# Accounts to scan: login:org or login:user, comma-separated.
# GITHUB_TARGETS=my-org:org,my-user:user
# A fine-grained personal access token (Pull requests read/write, Contents read, Metadata read).
# GITHUB_TOKEN=
# A GitHub App: its ID, its private key (a file path, or the PEM with \n for newlines),
# and the webhook secret you gave it.
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY_FILE=/run/secrets/github-app.pem
# GITHUB_WEBHOOK_SECRET=
# GitHub Enterprise Server: https://github.example.com/api/v3
# GITHUB_API_URL=https://api.github.com
# Branchwarden's own address, for links in messages and the webhook URL.
# PUBLIC_URL=https://branchwarden.example.com:8443
